# Copier ce fichier en .env et adapter les valeurs.
PORT=3000
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=RunX

# Compte administrateur créé / synchronisé au démarrage
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-moi-maintenant

# Secret de signature des jetons (générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=12h

# Durée de conservation des logs (0 = illimitée)
LOG_RETENTION_DAYS=90

# true si l'application est derrière un reverse proxy (nginx, traefik...)
TRUST_PROXY=false
